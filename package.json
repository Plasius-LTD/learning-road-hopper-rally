{
  "name": "@plasius/learning-road-hopper-rally",
  "version": "1.1.0",
  "description": "Immutable Road Hopper Rally curriculum, deterministic runtime, assets, and assessment contracts.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "legal"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./browser-worker": {
      "types": "./dist/browser-worker.d.ts",
      "import": "./dist/browser-worker.js",
      "require": "./dist/browser-worker.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "vitest run --coverage",
    "audit:all": "npm run typecheck && npm run audit:eslint && npm run audit:deps && npm run audit:npm && npm run audit:test",
    "lint": "eslint . --max-warnings=0",
    "pack:check": "node scripts/verify-public-package.cjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run pack:check"
  },
  "keywords": [
    "learning",
    "javascript",
    "game-development",
    "deterministic",
    "quickjs",
    "road-hopper",
    "plasius"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/learning-road-hopper-rally.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/learning-road-hopper-rally/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/learning-road-hopper-rally#readme",
  "dependencies": {
    "@plasius/game-audio": "0.1.3",
    "@plasius/learning": "0.2.21",
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Plasius-LTD"
    }
  ],
  "overrides": {
    "esbuild": "^0.28.1",
    "minimatch": "^10.2.1"
  },
  "engines": {
    "node": ">=24"
  }
}
